# Copy this file to .env and fill in real values
# .env is listed in .gitignore — NEVER commit the real .env

# PostgreSQL
# Local:    jdbc:postgresql://localhost:5432/snippetvault
# Supabase: use the SESSION POOLER details from Connect -> Session pooler:
#   DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
#   DB_USERNAME=postgres.<project-ref>
DB_URL=jdbc:postgresql://localhost:5432/snippetvault
DB_USERNAME=postgres
DB_PASSWORD=change_me_in_production

# Redis (one URL). Local: redis://localhost:6379
# Upstash (TLS): rediss://default:<password>@<endpoint>:6379
REDIS_URL=redis://localhost:6379

# JWT
# Generate a strong secret: openssl rand -base64 64
JWT_SECRET=replace_with_base64_encoded_256bit_or_longer_secret
JWT_ACCESS_EXPIRY_MS=1800000
JWT_REFRESH_EXPIRY_MS=604800000

# Server port (the hosting platform injects $PORT automatically; leave 8080 locally)
PORT=8080
