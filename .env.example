# Copy this file to .env and fill in real values
# .env is listed in .gitignore — NEVER commit the real .env

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/snippetvault
DB_USERNAME=postgres
DB_PASSWORD=change_me_in_production

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
# Generate a strong secret: openssl rand -base64 64
JWT_SECRET=replace_with_base64_encoded_256bit_or_longer_secret
JWT_ACCESS_EXPIRY_MS=1800000
JWT_REFRESH_EXPIRY_MS=604800000

# Server port (Railway injects $PORT automatically; leave 8080 locally)
PORT=8080
